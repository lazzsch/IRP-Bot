{
  "manifest_version": 3,
  "name": "IRP Bot V3",
  "version": "3.0.0",
  "description": "Automates IRP rescheduling checks with configurable delays and on-page console.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://portal.irishimmigration.ie/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "IRP Bot V3",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.irishimmigration.ie/*"
      ],
      "js": [
        "shared/irp-common.js",
        "shared/irp-config.js",
        "shared/content-i18n.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
